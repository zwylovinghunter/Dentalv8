# 复制为服务器上的 /etc/dentalv8/dentalv8.env，再按实际平台填写。
# 不要把真实密钥提交到 Git。

# 监听配置（app.py 默认值即可）
DENTAL_HOST=127.0.0.1
DENTAL_PORT=7860

# 仅在 HTTPS 反向代理已启用时设为 1；本地 HTTP 演示保持 0。
DENTAL_SESSION_COOKIE_SECURE=0
DENTAL_SESSION_MAX_AGE=86400

# AI 平台：aliyun / google / ollama / local
DENTAL_AI_PROVIDER=aliyun
DASHSCOPE_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api/chat

# 运行目录与自动清理策略
DENTAL_RUNTIME_ROOT=/var/lib/dentalv8/runtime
OUTPUT_RETENTION_DAYS=3
OUTPUT_MAX_GB=1
OUTPUT_CLEANUP_INTERVAL_SECONDS=1800
